
$page-bg: #111111;
$card-bg: #000000;
$primary: #F2C500;
$text: #FFFFFF;
$muted: #A3A3A3;
$purple: #6D4CC2;

/* Reusable profile component */
@define profile-surface(bg: #000000) {
  background: @use(bg);
  border-radius: 18px;
  padding: 24px;
}

/* Page styling */
body {
  bg: $page-bg!;
  color: $text!;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24px;
}

/* Main profile card */
.profile-card {
  @profile-surface()
  width: 100%;
  max-width: 420px;
  color: $text!;
  border: 1px solid #333333;
  text-align: center;
}

/* Profile image */
.profile-card > img {
  width: 120px;
  height: 120px;
  rounded: 50%;
  object-fit: cover;
  display: block;
  margin: 0 auto 20px;
}

/* Main heading */
.profile-card h1 {
  color: $primary!;
  font-size: 32px;
  font-weight: 700;
  margin-bottom: 8px;
}

/* Full name */
.profile-card h3 {
  color: $text!;
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 12px;
}

/* Description */
.profile-card p {
  color: $muted!;
  font-size: 14px;
  line-height: 1.6;
  margin-bottom: 20px;
}

/* Tags container */
.tags {
  @profile-surface(#1A1A1A)
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
}

/* Individual tags */
.var,
.reuse,
.syn,
.sty {
  bg: #1A1A1A;
  color: $primary!;
  px: 12px;
  py: 8px;
  rounded: 20px;
  font-size: 12px;
}

/* Social links container */
.social-links {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  margin-top: 24px;
}

/* Social link backgrounds */
.social-links a {
  bg: #1A1A1A;
  width: 42px;
  height: 42px;
  rounded: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* Social icons */
.social-links img {
  width: 20px;
  height: 20px;
}
